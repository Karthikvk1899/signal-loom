  "components": {
    "schemas": {
      "ActivateInput": {
        "properties": {
          "expected_generation": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Generation"
          },
          "rollback": {
            "type": "boolean",
            "title": "Rollback",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_generation"
        ],
        "title": "ActivateInput"
      },
      "Bundle": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 1.0,
            "title": "Schema Version",
            "default": 1
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/Flag"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Flags"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "flags"
        ],
        "title": "Bundle"
      },
      "CredentialInput": {
        "properties": {
          "tenant": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Tenant"
          },
          "actor": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Actor"
          },
          "role": {
            "type": "string",
            "enum": [
              "author",
              "reviewer",
              "reader"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant",
          "actor",
          "role"
        ],
        "title": "CredentialInput"
      },
      "DraftInput": {
        "properties": {
          "bundle": {
            "$ref": "#/components/schemas/Bundle"
          },
          "base_generation": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Base Generation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bundle",
          "base_generation"
        ],
        "title": "DraftInput"
      },
      "EnvironmentInput": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "EnvironmentInput"
      },
      "Flag": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Key"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "rollout": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Rollout"
          },
          "salt": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Salt"
          },
          "allow": {
            "items": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 100,
            "title": "Allow"
          },
          "deny": {
            "items": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 100,
            "title": "Deny"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "rollout",
          "salt"
        ],
        "title": "Flag"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PreviewInput": {
        "properties": {
          "bundle": {
            "$ref": "#/components/schemas/Bundle"
          },
          "flag": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Flag"
          },
          "subjects": {
            "items": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Subjects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bundle",
          "flag",
          "subjects"
        ],
        "title": "PreviewInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
